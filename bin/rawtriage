#!/usr/bin/env python3
"""rawtriage — triage RawNotes through the rawnotes-triage server (python stdlib only).

  rawtriage                          AI-assisted triage: starts a Claude session that uses the rawnotes skill
  rawtriage -l [status] [--json]     print the Inbox: status, type, age, date, title, stale/expired flags
  rawtriage -l --summary             one line: "N open, N cooking (N stale, N expired)" (the weekly nudge prints it)
  rawtriage where                    the notes folder and the projects root
  rawtriage check                    notes whose header is missing or invalid
  rawtriage new <slug> [thought]     create today's note from _template.md
  rawtriage keep <file> [--status open|cooking] [--next TEXT]      refused once the note is expired
  rawtriage kill <file> --reason TEXT
  rawtriage reference <file> [--why TEXT] [--section NAME [--blurb TEXT]]
                                     file as reference; --section also adds its line to reference/README.md's index
  rawtriage reference --unindexed    reference notes the index doesn't link yet, and the index's sections
  rawtriage index <name.md> --section NAME [--blurb TEXT]   add an already-filed reference note to the index
  rawtriage promote <file> --dest active|experiments|learning|templates --done TEXT
                    [--due-days N | --due YYYY-MM-DD] [--slug S]
  rawtriage merge <file> <file>... --title TEXT [--then inbox|promote|reference] [promote options]
  rawtriage undo                     reverse the newest change (the page's undo list is the same one)
  rawtriage project ship <name> [--kind KIND]           a single-file project; a folder needs --outcome (see close)
  rawtriage project extend <name> --reason TEXT [--days N] [--kind KIND]   at most twice; the reason is required
  rawtriage project kill <name> --reason TEXT [--kind KIND]   a folder moves to archive/<name>_abandoned
  rawtriage project close <name> --outcome next|maintained|archive [--kind KIND]
                    next: --done TEXT and --due YYYY-MM-DD | --due-days N (experiments may skip the ship-by)
                    maintained / archive: the folder moves there; refused while something points at it
  rawtriage project deps <name> [--to maintained|archive|abandoned] [--kind KIND]
                                     what points at the folder (blockers, and to-dos for after a move); read-only
  rawtriage project github <name> [--kind KIND]   first push: private GitHub repo + push main (this machine only)

Every command goes through the running server, so a decision made here is logged, undoable in the page and counted
in Pulse exactly like one made in the page. If the server is down it is started (the systemd unit if installed, else
server.py --no-browser). If that fails, or something else answers on the port, rawtriage exits 2 and has changed
nothing; do not edit notes by hand instead. Exit codes: 0 done, 1 refused (the server's reason is printed), 2 no server
(nothing changed), 3 the connection was lost after a change was sent: the server may have finished it, so check
`rawtriage -l` or the page before retrying. Slow changes (promote, merge, close out, ship/kill, project github) wait up
to 300 s, everything else 60 s (RAWTRIAGE_TIMEOUT overrides both, in seconds).
--json prints the server's answer. RAWTRIAGE_PORT picks another port (default 8765).
"""
import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
PORT = int(os.environ.get("RAWTRIAGE_PORT") or 8765)
BASE = f"http://127.0.0.1:{PORT}"
UNIT = "rawtriage-web.service"
WAIT = 5.0  # seconds to wait for a server we just started
PROMPT = ("Raw note triage session. Use the rawnotes skill (its triage workflow): list the backlog with `rawtriage -l`, "
          "then walk me through the notes one at a time and make me decide. Decide only through the rawtriage command.")


class Refused(Exception):
    """The server answered, but said no."""


class NoServer(Exception):
    """There is no usable server; nothing was changed."""


class Lost(Exception):
    """The connection broke (or timed out) after a change was sent: the server may still have made it."""


SLOW = ("/api/project/github", "/api/project/close", "/api/project/status", "/api/merge")  # git, gh, a push, a folder move


def timeout_for(path, body=None):
    """Seconds to wait for an answer: 300 for the routes that run git/gh or move folders (and promote), else 60."""
    if os.environ.get("RAWTRIAGE_TIMEOUT"): return float(os.environ["RAWTRIAGE_TIMEOUT"])
    slow = path.split("?")[0] in SLOW or (path == "/api/action" and isinstance(body, dict) and body.get("action") == "promote")
    return 300 if slow else 60


def say(*a): print(*a, flush=True)


def die(msg, code):
    print(f"rawtriage: {msg}", file=sys.stderr); sys.exit(code)


def _get(path, timeout=3):
    with urllib.request.urlopen(BASE + path, timeout=timeout) as r: return json.loads(r.read())


def probe():
    """'up' (our server), 'down' (nothing listening) or 'foreign' (something else answers)."""
    try: info = _get("/api/version", timeout=2)
    except urllib.error.HTTPError: return "foreign"
    except (OSError, ValueError): return "down"  # URLError, refused, timeout, or a non-JSON answer from a half-started server
    return "up" if isinstance(info, dict) and info.get("app") == "rawnotes-triage" else "foreign"


def wait_up():
    end = time.time() + WAIT
    while time.time() < end:
        state = probe()
        if state != "down": return state
        time.sleep(0.15)
    return "down"


def unit_name():
    """The systemd user unit to start when the server is down: the installed one, which always listens on 8765, so only
    for that port (RAWTRIAGE_UNIT names another, for tests). '' = none installed."""
    unit = os.environ.get("RAWTRIAGE_UNIT") or (UNIT if PORT == 8765 else "")
    if not unit: return ""
    try: return unit if subprocess.run(["systemctl", "--user", "cat", unit], capture_output=True, timeout=10).returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired): return ""


def ensure_server():
    """Make sure our server answers; otherwise raise NoServer before anything has been changed."""
    state = probe()
    if state == "down":
        unit = unit_name()
        if unit:
            try: ok = subprocess.run(["systemctl", "--user", "start", unit], capture_output=True, timeout=30).returncode == 0
            except (OSError, subprocess.TimeoutExpired): ok = False
            if not ok: raise NoServer(f"the triage server isn't running and `systemctl --user start {unit}` failed")
        else:
            try:
                subprocess.Popen([sys.executable, os.path.join(REPO, "server.py"), "--no-browser", "--port", str(PORT)],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True, cwd=REPO)
            except OSError as e: raise NoServer(f"the triage server isn't running and couldn't be started ({e})")
        state = wait_up()
    if state == "foreign": raise NoServer(f"something that isn't rawnotes-triage answers on port {PORT}")
    if state == "down": raise NoServer("the triage server isn't running and couldn't be started")


def api(path, body=None):
    """GET (body None) or POST JSON to the server; returns the parsed answer. Raises Refused or NoServer."""
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(BASE + path, data=data, method="GET" if body is None else "POST",
                                 headers={} if body is None else {"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout_for(path, body)) as r: return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try: msg = json.loads(e.read()).get("error") or f"HTTP {e.code}"
        except (ValueError, AttributeError): msg = f"HTTP {e.code}"
        raise Refused(msg)
    except urllib.error.URLError as e:
        if isinstance(e.reason, (ConnectionRefusedError, FileNotFoundError)) or body is None:
            raise NoServer(f"lost the triage server ({e.reason})")  # nothing was sent (or it was only a read)
        raise Lost(f"lost the triage server after sending the change ({e.reason}); the server may have finished it: "
                   f"check `rawtriage -l` or the page before retrying")
    except (OSError, ValueError) as e:
        if body is None: raise NoServer(f"lost the triage server ({e or type(e).__name__})")
        raise Lost(f"lost the triage server after sending the change ({e or type(e).__name__}); the server may have finished it: "
                   f"check `rawtriage -l` or the page before retrying")


class Parser(argparse.ArgumentParser):
    def error(self, message):  # exit 1, not argparse's 2: 2 means "no server" here
        self.print_usage(sys.stderr); print(f"rawtriage: {message}", file=sys.stderr); sys.exit(1)


def make_parser():
    p = Parser(prog="rawtriage", description="Triage RawNotes through the rawnotes-triage server.")
    common = Parser(add_help=False); common.add_argument("--json", action="store_true", help="print the server's answer as JSON")
    sub = p.add_subparsers(dest="cmd", parser_class=Parser)
    def add(name, help, *args, **kw):
        sp = sub.add_parser(name, help=help, parents=[common], **kw)
        for a, k in args: sp.add_argument(*a, **k)
        return sp
    add("where", "print the notes folder and the projects root")
    add("check", "list notes with a missing or invalid header")
    add("new", "create today's note from _template.md", (("slug",), {}), (("thought",), {"nargs": "*"}))
    add("keep", "keep a note in the Inbox", (("file",), {}), (("--status",), {"choices": ["open", "cooking"], "default": "cooking"}),
        (("--next",), {"default": "", "help": "a next-step line to add"}))
    add("kill", "kill a note (to the Archive)", (("file",), {}), (("--reason",), {"required": True}))
    add("reference", "file a note as reference (or list unindexed reference notes)", (("file",), {"nargs": "?"}), (("--why",), {"default": ""}),
        (("--section",), {"default": "", "help": "an index section (### heading) in reference/README.md; a new name adds one"}),
        (("--blurb",), {"default": "", "help": "the index line's summary (default: the why, else the question's first sentence)"}),
        (("--unindexed",), {"action": "store_true", "help": "list reference notes the index doesn't link"}))
    add("index", "add an already-filed reference note to reference/README.md's index", (("file",), {}),
        (("--section",), {"required": True}), (("--blurb",), {"default": ""}))
    promo = [(("--dest",), {"choices": ["active", "experiments", "learning", "templates"]}), (("--done",), {"default": "", "help": "what done means"}),
             (("--due-days",), {"type": int}), (("--due",), {"help": "ship-by date YYYY-MM-DD"}), (("--slug",), {"default": ""})]
    add("promote", "promote a note to a project", (("file",), {}), *promo)
    add("merge", "merge notes into one", (("files",), {"nargs": "+"}), (("--title",), {"required": True}),
        (("--then",), {"choices": ["inbox", "promote", "reference"], "default": "inbox"}), (("--question",), {"default": ""}), *promo)
    add("undo", "undo the newest change")
    pr = add("project", "ship, push, kill, close out or put a project on GitHub", (("action",), {"choices": ["ship", "extend", "kill", "close", "deps", "github"]}), (("name",), {}),
             (("--kind",), {"choices": ["active", "experiments", "learning", "templates"]}),
             (("--reason", "--note"), {"dest": "reason", "default": "", "help": "why: required to extend or kill"}), (("--days",), {"type": int}),
             (("--outcome",), {"choices": ["next", "maintained", "archive"], "help": "what happens after shipping a folder"}),
             (("--done",), {"default": "", "help": "next round: what done means"}), (("--due",), {"help": "next round: ship-by YYYY-MM-DD"}),
             (("--due-days",), {"type": int, "help": "next round: ship-by in N days"}),
             (("--to",), {"choices": ["maintained", "archive", "abandoned"], "help": "deps: the move to check for"}))
    return p


def out(args, data, text):
    say(json.dumps(data, indent=2, ensure_ascii=False) if getattr(args, "json", False) else text)


def note_name(arg):
    """The name the server wants for a note: a path inside the notes folder is made relative; an unambiguous part of a
    name (the slug, say) is completed from the Inbox."""
    notes = api("/api/notes")
    root = notes.get("notes_dir", "").rstrip("/") + "/"
    if arg.startswith(root): arg = arg[len(root):]
    names = [n["file"] for n in notes["live"]]
    if arg in names or arg.startswith("done/"): return arg
    hits = [n for n in names if arg in n]
    if len(hits) == 1: return hits[0]
    if len(hits) > 1: raise Refused(f"“{arg}” matches {len(hits)} notes: " + ", ".join(hits))
    return arg  # let the server say it's not there


def promote_body(args):
    if args.dest not in (None, "experiments") and args.due is None and args.due_days is None:
        raise Refused("Give a ship-by: --due-days N or --due YYYY-MM-DD (only experiments are open-ended).")
    body = {"dest": args.dest, "note": args.done, "slug": args.slug}
    if args.due is not None: body["due"] = args.due
    if args.due_days is not None: body["due_days"] = args.due_days
    return body


def check_project(args):
    if args.action == "close" and not args.outcome:
        raise Refused(f"Say what happens next: rawtriage project close {args.name} --outcome next|maintained|archive "
                      f"(`rawtriage project deps {args.name}` shows the suggestion and what points at it)")
    if args.outcome == "next" and not args.done.strip():
        raise Refused("A next round needs --done \"what done means\" and a ship-by (--due YYYY-MM-DD or --due-days N)")
    if args.action in ("extend", "kill") and not args.reason.strip():
        raise Refused(f"Say why: rawtriage project {args.action} {args.name} --reason \"...\"" +
                      (" (at least 10 characters; a ship-by date can be pushed twice)" if args.action == "extend" else ""))


def project_body(args):
    if args.action == "github": return {"name": args.name, "kind": folder_kind(args)}
    action = {"ship": "shipped"}.get(args.action, args.action)
    body = {"action": action, "note": args.reason}
    if args.days is not None: body["days"] = args.days
    flights = [x for x in api("/api/notes").get("inflight", [])
               if not x["done"] and (x["project"] or os.path.basename(x["path"])[:-3]) == args.name and (not args.kind or x["dest"] == args.kind)]
    if len(flights) > 1: flights = [x for x in flights if x["path"].endswith("/NOTES.md")] or flights
    if len(flights) > 1: raise Refused(f"“{args.name}” has {len(flights)} promoted files; say --kind or fix it in the page")
    if flights: return {**body, "path": flights[0]["path"]}
    if args.action == "extend": raise Refused(f"“{args.name}” has no ship-by date to push")
    return {**body, "name": args.name, "kind": folder_kind(args)}


def folder_kind(args):
    """The kind of the project folder called args.name: --kind, else the one folder on the board with that name."""
    if args.kind: return args.kind
    kinds = [p["kind"] for p in api("/api/projects").get("projects", []) if p["name"] == args.name]
    if len(kinds) > 1: raise Refused(f"“{args.name}” is in {', '.join(kinds)}: say --kind")
    return kinds[0] if kinds else "active"


def close_body(args):
    body = {"name": args.name, "kind": folder_kind(args), "outcome": args.outcome, "action": "shipped"}
    if args.outcome == "next":
        body["done"] = args.done
        if args.due is not None: body["due"] = args.due
        if args.due_days is not None: body["due_days"] = args.due_days
    return body


def closed_text(r):
    """The server's message, plus what is left to do by hand after a move."""
    lines = [r["msg"]]
    if r.get("todos"): lines += ["Left to do by hand (also written under ## Moved in its NOTES.md):"] + [f"- {t['fix']}" for t in r["todos"]]
    if r.get("sync_apps") == "failed": lines.append("sync-apps failed (see the server's log); run it yourself so Obsidian's Apps/ links follow.")
    return "\n".join(lines)


def deps_text(r):
    lines = [f"{r['path']} → {r['dest']} (suggested: {r['suggest']})"]
    lines += ([f"BLOCKED: {len(r['blockers'])} thing(s) would break; fix each first:"] + [f"- {b['where']}: {b['detail'].splitlines()[0]}\n  fix: {b['fix']}" for b in r["blockers"]]
              if r["blockers"] else ["Nothing blocks the move."])
    if r["todos"]: lines += ["After the move, by hand:"] + [f"- {t['fix']}" for t in r["todos"]]
    return "\n".join(lines)


def run(args):
    c = args.cmd
    if c == "where":
        s = api("/api/setup")
        return out(args, {"notes_dir": s["notes_dir"], "projects_dir": s["projects_dir"]}, f"notes: {s['notes_dir']}\nprojects: {s['projects_dir']}")
    if c == "check":
        r = api("/api/check")
        text = (f"RawNotes header check: {len(r['problems'])} note(s) don't have a complete header.\n" +
                "\n".join(f"- {p['file']} — missing/invalid: {', '.join(p['issues'])}" for p in r["problems"])
                if r["problems"] else f"All {r['checked']} notes have a complete header.")
        return out(args, r, text)
    if c == "new":
        r = api("/api/new", {"slug": args.slug, "thought": " ".join(args.thought)})
        return out(args, r, f"{r['msg']}\n{r['path']}")
    if c == "reference" and args.unindexed:
        r = api("/api/reference/unindexed")
        if not r["has_index"]: return out(args, r, "reference/README.md has no ## Index section (or there is no README.md).")
        text = (f"{len(r['files'])} reference note(s) aren't in the index" + (":" if r["files"] else ".") +
                "".join(f"\n- {f['file']}  {f['title']}: {f['blurb']}" for f in r["files"]) +
                "\nSections: " + (", ".join(r["sections"]) or "(none yet)") +
                ("\nAdd one with: rawtriage index <name.md> --section NAME [--blurb TEXT]" if r["files"] else ""))
        return out(args, r, text)
    if c == "index":
        r = api("/api/reference/index", {"file": os.path.basename(args.file), "section": args.section, "blurb": args.blurb}); return out(args, r, r["msg"])
    if c == "undo":
        r = api("/api/undo", {}); return out(args, r, r["msg"])
    if c == "project" and args.action == "deps":
        kind = folder_kind(args)
        r = api(f"/api/project/deps?name={urllib.parse.quote(args.name)}&kind={kind}" + (f"&to={args.to}" if args.to else ""))
        return out(args, r, deps_text(r))
    if c == "project" and (args.action == "close" or (args.action == "ship" and args.outcome)):
        r = api("/api/project/close", close_body(args)); return out(args, r, closed_text(r))
    if c == "project":
        if args.action == "github": r = api("/api/project/github", project_body(args)); return out(args, r, r["msg"])
        r = api("/api/project/status", project_body(args)); return out(args, r, closed_text(r))
    if c == "merge":
        body = {"files": [note_name(f) for f in args.files], "title": args.title, "then": args.then, "question": args.question}
        if args.then == "promote": body.update(promote_body(args))
        elif args.then == "reference": body.update({"note": args.done, "slug": args.slug})
        r = api("/api/merge", body); return out(args, r, r["msg"])
    body = {"file": note_name(args.file)}
    if c == "keep": body.update(action="keep", status=args.status, note=args.next)
    elif c == "kill": body.update(action="kill", note=args.reason)
    elif c == "reference":
        body.update(action="reference", note=args.why)
        if args.section: body.update(section=args.section, blurb=args.blurb)
    elif c == "promote": body.update(action="promote", **promote_body(args))
    r = api("/api/action", body); out(args, r, r["msg"])


def list_notes(argv):
    lp = Parser(prog="rawtriage -l"); lp.add_argument("status", nargs="?"); lp.add_argument("--json", action="store_true")
    lp.add_argument("--summary", action="store_true", help="one line of counts: N open, N cooking (N stale, N expired)")
    a = lp.parse_args(argv)
    ensure_server()
    data = api("/api/notes")
    if a.summary: return say(json.dumps({"summary": data["summary"]}) if a.json else data["summary"])
    live = [n for n in data["live"] if not a.status or n["status"] == a.status]
    if a.json: return say(json.dumps(live, indent=2, ensure_ascii=False))
    say("%-8s %-9s %-4s %-10s %s" % ("STATUS", "TYPE", "AGE", "DATE", "TITLE"))
    if not live and not a.status: say("(no notes)")
    for n in live:
        age = "?" if n.get("age") is None else n["age"]
        flags = "".join(f"  [{k}]" for k in ("stale", "expired") if n.get(k))
        say("%-8s %-9s %3sd %-10s %s  (%s)%s" % (n["status"], n["type"], age, n["date"], n["title"], n["file"], flags))


def session():
    """No arguments: a Claude triage session, started in the notes folder when the server can say where it is."""
    try:
        ensure_server(); notes = api("/api/setup")["notes_dir"]
        if os.path.isdir(notes): os.chdir(notes)
    except (NoServer, Refused) as e: print(f"rawtriage: {e}; starting the session anyway, but it cannot decide anything until the server is up", file=sys.stderr)
    try: os.execvp("claude", ["claude", "--model", "haiku", "--effort", "low", PROMPT])
    except OSError as e: die(f"can't start claude ({e})", 1)


def main(argv):
    if not argv: return session()
    if argv[0] in ("-l", "--list"): return list_notes(argv[1:])
    args = make_parser().parse_args(argv)
    if not args.cmd: make_parser().error("give a command (or -l); see --help")
    if args.cmd == "promote": promote_body(args)  # refuse a missing ship-by or reason before even looking for the server
    if args.cmd == "project": check_project(args)
    if args.cmd == "reference" and not args.unindexed and not args.file: make_parser().error("give a note to file, or --unindexed")
    ensure_server()
    run(args)


if __name__ == "__main__":
    try: main(sys.argv[1:])
    except Refused as e: print(f"rawtriage: {e}", file=sys.stderr); sys.exit(1)
    except Lost as e: print(f"rawtriage: {e}", file=sys.stderr); sys.exit(3)
    except NoServer as e: print(f"rawtriage: {e}. Nothing was changed.", file=sys.stderr); sys.exit(2)
